{
  "cli": {
    "version": ">= 16.17.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "image": "macos-sequoia-15.5-xcode-26.0"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "ios": {
        "image": "macos-sequoia-15.5-xcode-26.0"
      }
    },
    "production": {
      "channel": "production",
      "ios": {
        "autoIncrement": "buildNumber",
        "image": "macos-sequoia-15.5-xcode-26.0"
      },
      "android": {
        "autoIncrement": "versionCode"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true,
        "image": "macos-sequoia-15.5-xcode-26.0"
      },
      "channel": "simulator"
    }
  },
  "submit": {
    "production": {}
  }
}
