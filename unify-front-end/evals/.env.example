# Copy to .env.local (gitignored). Required to run evals.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx    # Supabase Dashboard → Project Settings → API Keys → Secret keys (or legacy JWT under "Legacy API keys")
OPENROUTER_API_KEY=sk-or-v1-...            # for the Haiku judge calls
EVAL_BYPASS_SECRET=<random hex>            # must match EVAL_BYPASS_SECRET set via `supabase secrets set` (see evals/README.md)
